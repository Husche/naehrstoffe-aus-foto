# =============================================================================
# .env - Naehrstoffe aus Foto
# =============================================================================
# Diese Datei NICHT einchecken (steht in .gitignore). Werte lokal ausfuellen.
# Woher die jeweiligen Werte kommen -> siehe Kommentare unten je Block.
# =============================================================================


# --- 1. Mistral Vision (Foto-Analyse) - PFLICHT -------------------------------
# Quelle: https://console.mistral.ai -> API Keys -> neuen Key erzeugen (pay-as-you-go)
MISTRAL_API_KEY=

# Modell so lassen, ausser du willst gezielt ein anderes:
MISTRAL_MODEL=mistral-large-latest


# --- 2. Google Drive (parallele CSV-Speicherung) ------------------------------
# Quelle: https://console.cloud.google.com
#   1) Projekt anlegen/auswaehlen
#   2) APIs & Services -> Library -> "Google Drive API" -> Enable
#   3) APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#      Typ: Web application  ->  hier bekommst du Client ID + Client Secret
#   4) Unter dem OAuth-Client bei "Authorized redirect URIs" die produktive URL
#      eintragen (muss exakt mit GOOGLE_REDIRECT_URI uebereinstimmen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Muss exakt einer in der Google Console hinterlegten "Authorized redirect URI"
# entsprechen. Beispiel produktiv:
GOOGLE_REDIRECT_URI=https://naehrstoff.deine-domain.de/oauth/google/callback

# ID des Drive-Ordners, in den die CSVs landen sollen.
# Quelle: Drive-Ordner oeffnen, die ID steht in der URL:
#   https://drive.google.com/drive/folders/<DIESE_ID>
# (Vorausgefuellter Wert ist ein Beispiel -> durch eigene Ordner-ID ersetzen)
DRIVE_PARENT_FOLDER_ID=1L03oGMdv1dUcQxS5CssDh0sv028aDK6d


# --- 3. TimescaleDB / PostgreSQL (Gesundheitsdaten-DB) ------------------------
# Werte, die du beim DB-Setup selbst festlegst (SQL-Block in deploy/proxmox.md 7.1).
# Alternative: stattdessen DATABASE_URL setzen (dann werden PGHOST etc. ignoriert).

# Entweder als komplette Connection-URL:
#   DATABASE_URL=postgresql://naehrstoff:<passwort>@192.168.178.12:5432/health
DATABASE_URL=

# ... oder als Einzelschritte (werden ignoriert, wenn DATABASE_URL gesetzt ist):
# PGHOST  = IP des tsdb-Containers (Proxmox LXC 192.168.178.12)
# PGPORT = PostgreSQL-Standard 5432
# PGDATABASE / PGUSER = Namen aus CREATE DATABASE / CREATE USER
# PGPASSWORD = das Passwort aus "CREATE USER ... WITH PASSWORD '...'"
PGHOST=192.168.178.12
PGPORT=5432
PGDATABASE=health
PGUSER=naehrstoff
PGPASSWORD=

# PostgreSQL-Schema (default public, nur aendern wenn eigenes Schema angelegt)
DB_SCHEMA=public


# --- 4. Backend / Netz --------------------------------------------------------
# Container-interner Port, so lassen:
PORT=8787

# Deine externe produktive URL. WICHTIG: nicht "*" im Netz setzen
# (sonst ist die REST-API ohne Auth fuer jeden Origin offen).
CORS_ORIGIN=https://naehrstoff.deine-domain.de


# --- 5. Nutrition data source (Open Food Facts) - optional -------------------
# Oeffentliche kostenlose API, kein Key noetig. So lassen:
NUTRITION_API=https://world.openfoodfacts.org
