# --- Mistral Vision (food detection) ---
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest

# --- Google Drive (CSV export into "Health Analysis" folder) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/google/callback
DRIVE_PARENT_FOLDER_ID=1L03oGMdv1dUcQxS5CssDh0sv028aDK6d

# --- Backend ---
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- Nutrition data source (Open Food Facts, kostenlos) ---
NUTRITION_API=https://world.openfoodfacts.org

# --- TimescaleDB / PostgreSQL (Gesundheitsdaten-DB, optional) ---
# Wenn gesetzt, werden Nährwertdaten zustätzlich zur JSON-Datei in die DB
# geschrieben. Beide Spezialformen möglich:
#   a) DATABASE_URL als komplette Connection-URL
DATABASE_URL=
#   b) oder Einzelschritte (werden ignoriert, wenn DATABASE_URL gesetzt ist)
PGHOST=192.168.178.12
PGPORT=5432
PGDATABASE=health
PGUSER=naehrstoff
PGPASSWORD=
# PostgreSQL-Schema (default public)
DB_SCHEMA=public
